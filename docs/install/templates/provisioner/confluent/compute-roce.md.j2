<!-- ohpc_begin -->
<!-- ohpc_comment Optionally configure the RoCE network on compute nodes -->
<!-- ohpc_if_set enable_roce -->
<!-- ohpc_if [[ -n "${roce_dev}" ]] -->
```bash
for ((i=0; i<num_computes; i++)) ; do
	nodeattrib "${c_name[$i]}" net.roce.interface_names="${roce_dev}" \
		net.roce.ipv4_address="${c_roce[$i]}/${roce_prefix_length}"
done
```
<!-- ohpc_fi -->
<!-- ohpc_fi -->
<!-- ohpc_end -->
